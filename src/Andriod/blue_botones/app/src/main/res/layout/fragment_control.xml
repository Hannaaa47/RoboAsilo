<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <!-- Header -->
    <TextView
        android:text="CONTROL REMOTO"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#00E5FF"
        android:textSize="13sp"
        android:letterSpacing="0.2"
        android:fontFamily="monospace"
        android:paddingBottom="4dp"/>

    <!-- Estado -->
    <TextView
        android:id="@+id/tv_estado_ctrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="● Desconectado"
        android:textColor="#FF5252"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:paddingBottom="24dp"/>

    <!-- ── D-PAD ── -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="28dp">

        <!-- Fila 1: Arriba -->
        <Button
            android:id="@+id/btn_arriba"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:text="▲"
            android:textSize="28sp"
            android:textColor="#121212"
            android:backgroundTint="#0F66AE"
            android:layout_marginBottom="6dp"/>

        <!-- Fila 2: Izquierda | Derecha -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btn_izquierda"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#0F66AE"
                android:text="◀"
                android:textColor="#121212"
                android:textSize="28sp" />

            <!-- Centro vacío (espacio visual) -->
            <View
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="#1A1A1A"/>

            <Button
                android:id="@+id/btn_derecha"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:text="▶"
                android:textSize="28sp"
                android:textColor="#121212"
                android:backgroundTint="#0F66AE"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <!-- Fila 3: Abajo -->
        <Button
            android:id="@+id/btn_abajo"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:text="▼"
            android:textSize="28sp"
            android:textColor="#121212"
            android:backgroundTint="#0F66AE"/>
    </LinearLayout>

    <!-- Separador -->
    <View
        android:layout_width="200dp"
        android:layout_height="1dp"
        android:background="#2A2A2A"
        android:layout_marginBottom="24dp"/>

    <!-- ── Botones de sierra y stop ── -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_sierra_on"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:text="⚙ SIERRA ON"
            android:textSize="13sp"
            android:textColor="#121212"
            android:backgroundTint="#69F0AE"
            android:layout_marginEnd="10dp"/>

        <Button
            android:id="@+id/btn_sierra_off"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:text="⚙ SIERRA OFF"
            android:textSize="13sp"
            android:textColor="#ECEFF1"
            android:backgroundTint="#546E7A"/>
    </LinearLayout>

    <!-- STOP -->
    <Button
        android:id="@+id/btn_stop"
        android:layout_width="260dp"
        android:layout_height="64dp"
        android:text="■  STOP"
        android:textSize="18sp"
        android:letterSpacing="0.15"
        android:textColor="#ECEFF1"
        android:backgroundTint="#D50000"/>

    <!-- Leyenda de comandos -->

</LinearLayout>